---
// Componente de Chatbot Legal Inteligente
---
<div class="chatbot-widget" id="chatbotWidget">
  <!-- Ventana de Chat -->
  <div class="chatbot-window" id="chatbotWindow" role="dialog" aria-labelledby="chatbotTitle" hidden>
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar">
          <i class="fa-solid fa-scale-balanced"></i>
          <span class="status-dot"></span>
        </div>
        <div class="chatbot-title">
          <h2 id="chatbotTitle">Asistente Valor & Asoc.</h2>
          <span>Recorrido guiado • Demo</span>
        </div>
      </div>
      <div class="chatbot-actions">
        <button class="chat-btn-icon" id="chatbotClose" aria-label="Cerrar chat">
          <span class="control-symbol" aria-hidden="true">×</span>
        </button>
      </div>
    </div>

    <div class="chatbot-messages" id="chatbotMessages" role="log" aria-live="polite" aria-relevant="additions" aria-label="Conversación guiada">
      <!-- Mensajes inyectados dinámicamente -->
    </div>

    <div class="chatbot-footer">
      <div class="chatbot-input-row">
        <label for="chatbotInput" class="sr-only">Área o provincia, sin datos personales</label>
        <input type="text" id="chatbotInput" class="chatbot-input" maxlength="120" autocomplete="off" placeholder="Área o provincia, sin datos personales" />
        <button id="chatbotSend" class="chatbot-send-btn" aria-label="Enviar">
          <span class="control-symbol" aria-hidden="true">→</span>
        </button>
      </div>
      <p class="chatbot-disclaimer">No reemplaza a un profesional. No ingreses detalles de un caso real.</p>
      <button type="button" id="chatbotReset" class="chat-option-btn">Borrar conversación y reiniciar</button>
    </div>
  </div>

  <!-- Gatillador Flotante -->
  <button class="chatbot-trigger" id="chatbotTrigger" aria-label="Abrir asistente legal" aria-controls="chatbotWindow" aria-expanded="false">
    <span class="control-symbol" aria-hidden="true">💬</span>
    <span class="chatbot-badge-alert" id="chatbotBadge">1</span>
  </button>
</div>

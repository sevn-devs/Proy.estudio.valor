---
// Componente Hero Slider Dinámico (Banners y Videos)
---
<section class="hero-slider-section">
  <div class="slider-container" id="heroSliderContainer">
    <div class="slide active">
      <div class="container slide-content">
        <h2 class="slide-title">Valor y Asociados</h2>
        <p class="slide-subtitle">Conocé las áreas de práctica y los canales de contacto.</p>
        <a class="btn btn-gold" href="#contacto">Preparar contacto</a>
      </div>
    </div>
  </div>

  <!-- Controles -->
  <button class="slider-btn prev" id="sliderPrev" aria-label="Banner anterior">
    <span class="control-symbol" aria-hidden="true">‹</span>
  </button>
  <button class="slider-btn next" id="sliderNext" aria-label="Banner siguiente">
    <span class="control-symbol" aria-hidden="true">›</span>
  </button>
  <div class="slider-dots" id="sliderDots"></div>
</section>
